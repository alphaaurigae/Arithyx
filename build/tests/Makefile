# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	cd /home/mmmm/Desktop/olddesk/own/repo-own/c++/math/math-hunter/build && $(CMAKE_COMMAND) -P /home/mmmm/Desktop/olddesk/own/repo-own/c++/math/math-hunter/build/CMakeFiles/VerifyGlobs.cmake
	cd /home/mmmm/Desktop/olddesk/own/repo-own/c++/math/math-hunter/build && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system

